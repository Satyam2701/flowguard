  "findings": [
    {
      "id": "F01",
      "title": "Expired or used reset link state not designed",
      "category": "Recovery",
      "priority": "P1",
      "priorityJustification": "Required by R06; users with an old link cannot continue and get no path to a new link; Missing from supplied evidence (7 frames reviewed)",
      "evidence": "R05, R06; no frame for an invalid link",
      "expected": "Explanation plus \"Send a new link\" (R06)",
      "observed": "Not found in the supplied evidence",
      "userImpact": "Users who open the link late or twice are stuck",
      "recommendedFix": "Add S08 with a short explanation and \"Send a new link\" returning to S02",
      "classification": "missing_from_evidence",
      "confidence": "high",
      "validationSteps": [
        "Review S08 design",
        "Open an expired link in the prototype or build"
      ],
      "relatedIds": [
        "S08",
        "T09",
        "T15"
      ]
    },
    {
      "id": "F02",
      "title": "Server error on password update not designed",
      "category": "Recovery",
      "priority": "P1",
      "priorityJustification": "Required by R09; a failed update blocks the reset with no designed retry; Missing from supplied evidence",
      "evidence": "R09 and acceptance criterion on retry; no error frame for server failure",
      "expected": "Error message and \"Try again\" that keeps the typed password (R09)",
      "observed": "Only the validation error (S06) exists",
      "userImpact": "Users may retype or restart the whole reset",
      "recommendedFix": "Add S09 banner with \"Try again\" that resubmits the same password",
      "classification": "missing_from_evidence",
      "confidence": "high",
      "validationSteps": [
        "Review S09",
        "Simulate server failure and retry"
      ],
      "relatedIds": [
        "S05",
        "S09",
        "T12",
        "T16"
      ]
    },
    {
      "id": "F03",
      "title": "Password rule errors cover length only",
      "category": "Forms",
      "priority": "P2",
      "priorityJustification": "R07 defines three rules; only the length error is designed; user can still discover rules by trial",
      "evidence": "S06 shows only \"Password must be at least 12 characters.\"; helper text on S05 omits the previous-password rule",
      "expected": "Specific errors for missing number and reuse of the previous password (R07)",
      "observed": "Not found in the supplied evidence",
      "userImpact": "Users do not learn why a 12-character password was rejected",
      "recommendedFix": "Add error variants for each rule and mention the reuse rule in helper text",
      "classification": "missing_from_evidence",
      "confidence": "high",
      "validationSteps": [
        "Review S06 variants"
      ],
      "relatedIds": [
        "S05",
        "S06",
        "T10"
      ]
    },
    {
      "id": "F04",
      "title": "Success screen does not mention that other sessions were signed out",
      "category": "Destructive and sensitive actions",
      "priority": "P3",
